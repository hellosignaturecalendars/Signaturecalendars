rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    // Deploy ONLY after merging with existing rules. Rename paths to match env config.
    match /signature_content_v1/{document} {
      allow read: if document == 'published' || admin();
      // All writes go through the validated, admin-authorized server API.
      allow write: if false;
    }
    match /signature_inquiries_v1/{document} {
      allow read: if admin();
      // Public creation is intentionally forbidden, including extra fields.
      // The server validates an exact allowlist, Turnstile and shared rate limits.
      allow write: if false;
    }
    match /signature_rate_limits_v1/{document} { allow read, write: if false; }
    // No blanket allow for authenticated users; unmatched paths deny by default.
  }
}
